// 20 EMA + all-time-high band
//
// Two things drawn on the candles, on WHATEVER timeframe the chart is set to:
//
//   the 20 EMA
//   the all-time high, and a band a chosen % below it
//
// Nothing is pulled from another timeframe. Switch the chart to weekly and you
// get the weekly 20 EMA and the weekly all-time high; switch to daily and you
// get the daily ones. Each timeframe has its own, which is the point.
//
// The all-time high is the highest CLOSE so far, today included. It is a step
// line: flat until a new high is made, then it jumps. That flatness is what
// makes the band readable -- the zone stays put while price moves through it.

//@version=5
// overlay      draw on the candles, not in a pane of its own
// scale.right   pin to the SAME price scale as the candles. Without it an
//               overlay can end up on its own axis, and then the lines drift
//               against the bars as you zoom -- they look unlocked because they
//               are, each scaling to its own range.
// format.price  read the values as prices, with the instrument's own tick size
indicator("20 EMA + ATH band", overlay = true, scale = scale.right,
          format = format.price)

len     = input.int(20,    "EMA length",        minval = 2)
bandPct = input.float(10., "Band below the high %", minval = 0, maxval = 90, step = 1)
useHigh = input.bool(false, "Use the highest HIGH instead of the highest close")
shade   = input.bool(true,  "Shade the band")
// A stock far below its record forces the y-axis to span from today's price all
// the way up to that record, which squashes the candles into a strip. Turn the
// high itself off and only the band floor is drawn: the zone still reads, and
// the chart keeps a normal scale.
showAth = input.bool(true,  "Draw the all-time-high line")

ema  = ta.ema(close, len)
ath  = useHigh ? ta.max(high) : ta.max(close)
floorLine = ath * (1 - bandPct / 100)

// ── the lines ─────────────────────────────────────────────────────────────
pEma   = plot(ema,       "20 EMA",        color = color.new(#2f6fd0, 0), linewidth = 2)
pAth   = plot(showAth ? ath : na, "All-time high", color = color.new(#8d8b82, 30),
              style = plot.style_stepline)
pFloor = plot(floorLine, "Band floor",    color = color.new(#0a7a4a, 20),
              style = plot.style_stepline, linewidth = 2)

// The zone between the high and the band floor. Anything inside it is "near the
// high"; anything below has further to climb than the band allows.
fill(pAth, pFloor, color = shade ? color.new(#0a7a4a, 92) : na, title = "band")

// ── where price actually is ───────────────────────────────────────────────
inBand   = close >= floorLine
aboveEma = close > ema

// Green where both are true, amber where the trend is fine but price sits below
// the band. The amber is the interesting one: it is what the band filter would
// refuse, and on the 101-stock backtest that refusal cost more than it saved.
bgcolor(inBand and aboveEma ? color.new(#0a7a4a, 90) :
        aboveEma            ? color.new(#c9a227, 92) : na, title = "state")

// ── a readout that MOVES WITH THE CHART ───────────────────────────────────
// This was a table.new(position.top_right) and tables are anchored to the
// SCREEN, not to the bars: scroll the chart and it sat there, welded to the
// corner while the candles slid underneath. A label is anchored to a bar, so it
// travels with the price like everything else here.
readout = input.bool(true, "Show the readout on the last bar")

gapPct = (close - ath) / ath * 100

if readout and barstate.islast
    var label tag = na
    label.delete(tag)
    tag := label.new(bar_index, close,
        text  = str.tostring(gapPct, "#.0") + "% below the high" +
                (inBand ? "  ·  in the band" : "  ·  outside"),
        style = label.style_label_left,
        color = color.new(inBand ? #0a7a4a : #c0392b, 85),
        textcolor = chart.fg_color, size = size.small)

// ── alerts, if you want telling rather than watching ──────────────────────
alertcondition(ta.crossover(close, ema),       "Crossed above the 20 EMA")
alertcondition(ta.crossunder(close, ema),      "Crossed below the 20 EMA")
alertcondition(ta.crossover(close, floorLine), "Entered the band below the high")
alertcondition(ta.crossunder(close, floorLine),"Fell out of the band")
