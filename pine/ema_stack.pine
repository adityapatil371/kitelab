//@version=6
// ============================================================================
// THE 20-EMA STACK — one script, three timeframe versions.
//
// THE CHART'S TIMEFRAME PICKS WHICH VERSION RUNS:
//     chart on 1W  ->  quarterly / monthly / weekly   (Q/M/W)
//     chart on 1D  ->  monthly  / weekly  / daily     (M/W/D — the class strategy)
//     chart on 1h  ->  weekly   / daily   / hourly    (W/D/H)
// Any other timeframe: the script deliberately takes NO trades and shows a
// warning banner instead of quietly producing wrong numbers.
//
// MIRRORS kitelab/backtest.py ema_stack_signal() + simulate() on a daily
// chart (the `ema` M/W/D row) and kitelab/timeframes.py stack_signal() +
// simulate_variant() on a weekly or hourly chart (Q/M/W, W/D/H).
//
// THE RULE (identical on all three, only the timeframes change):
//   ENTRY  buy at the close of the first chart bar whose close stands ABOVE
//          the 20-EMA on ALL THREE timeframes at once — the bare cross, band
//          0, as the board has traded since 2026-09-05 (kitelab.registry
//          BANDS). Three timeframes agreeing = the trend is real on every
//          scale you care about. The band input is kept at 0 by default; it
//          was 2% until 2026-09-07, when this script still drew the buffer
//          the Python had already dropped.
//   STOP   that entry bar's LOW. CLASS CONVENTION: the stop is checked at
//          CLOSES only — a wick dipping below it during the bar does NOT
//          sell; a close at or below it does. (A broker's resting stop order
//          would fire intrabar. That is a different, also valid, strategy —
//          but a manual end-of-bar backtester can only check closes, so
//          that is what the class does and what this script does.)
//   EXIT   sell at the close when either happens first:
//            - a close falls BELOW any one of the three EMAs (by the band,
//              if one is set), or
//            - a close is at/below the stop.
//   SIZE   risk 1% of a fixed 100,000 per trade: the distance to the stop
//          decides how many shares, capped by what the capital can buy.
//
// WHERE TO SEE THE RESULTS: the Strategy Tester panel at the bottom.
// TradingView computes net profit, the equity curve and MAX DRAWDOWN there
// by itself — which is exactly what makes this an independent check on our
// Python backtest. (For comparing with the lab's GROSS numbers, set
// commission to 0 in Settings -> Properties.)
// ============================================================================

// --- strategy declaration ---------------------------------------------------
// process_orders_on_close = true is the most important line for matching the
// class rule: orders placed on a bar FILL AT THAT BAR'S CLOSE. The default
// would fill them at the NEXT bar's open instead — a different strategy.
// The commission is a flat approximation of Zerodha delivery charges per side.
strategy("EMA Stack (kitelab)",
     overlay = true,                          // draw the EMAs on the price chart
     initial_capital = 100000,
     pyramiding = 0,                          // never add to an open position
     calc_on_every_tick = false,              // judge completed bars only
     process_orders_on_close = true,
     commission_type = strategy.commission.percent,
     commission_value = 0.11)

// --- inputs -----------------------------------------------------------------
// Exposed so anyone can experiment; the defaults are the tested class values.
lengthInput = input.int(20, "EMA length", minval = 2)
bandInput   = input.float(0.0, "Band % (enter above by, exit below by; board = 0)", minval = 0.0, step = 0.5)
riskInput   = input.float(1.0, "Risk % of capital per trade", minval = 0.1, step = 0.5)
fracInput   = input.bool(false, "Fractional units (crypto/commodities)",
     tooltip = "Whole shares suit NSE stocks. Turn ON for BTCUSDT and the " +
       "like: one whole coin costs more than the account, so whole-unit " +
       "sizing would floor the quantity to zero and reject every trade.")

// --- which timeframe triplet is this chart running? -------------------------
// timeframe.* describes the CHART the script is applied to. From the chart's
// own timeframe we derive the two HIGHER timeframes of the stack.
// ("3M" = one quarter; timeframe.multiplier == 60 = a 60-minute chart.)
isHourly = timeframe.isintraday and timeframe.multiplier == 60
tfOk     = timeframe.isweekly or timeframe.isdaily or isHourly
htfMid   = timeframe.isweekly ? "M"  : timeframe.isdaily ? "W" : "D"   // one step up
htfTop   = timeframe.isweekly ? "3M" : timeframe.isdaily ? "M" : "W"   // two steps up

// --- the three EMAs ---------------------------------------------------------
// The chart-timeframe EMA is ordinary: ta.ema on this chart's closes.
emaBase = ta.ema(close, lengthInput)

// The two higher-timeframe EMAs need care. Mid-week, the COMPLETED weekly
// EMA does not move — but a trader looking at a weekly chart mid-week sees
// the FORMING bar's value. We rebuild that forming value by hand with the
// EMA's own recurrence formula:
//     ema_now = alpha * current close + (1 - alpha) * ema(last COMPLETED bar)
// where alpha = 2 / (length + 1) is the EMA's standard smoothing weight.
alpha = 2.0 / (lengthInput + 1)

// request.security(...)[1] with lookahead_on is the standard NON-REPAINTING
// idiom for "the higher timeframe's LAST COMPLETED value": the [1] steps
// back one completed higher-TF bar (so nothing unfinished is ever used), and
// lookahead_on makes that completed value available on every chart bar
// inside the current higher-TF bar instead of one bar late.
midDone = request.security(syminfo.tickerid, htfMid, ta.ema(close, lengthInput)[1],
     lookahead = barmerge.lookahead_on)
topDone = request.security(syminfo.tickerid, htfTop, ta.ema(close, lengthInput)[1],
     lookahead = barmerge.lookahead_on)

// Blend the current close into each completed EMA -> the forming-bar value.
emaMid = alpha * close + (1 - alpha) * midDone
emaTop = alpha * close + (1 - alpha) * topDone

// --- entry and exit conditions ----------------------------------------------
// A non-zero band creates hysteresis (a dead zone): close ABOVE all three
// lines by the band to get in, BELOW any one of them by it to be forced out.
// Without the gap, price hugging an EMA flips the signal every bar and charges
// eat the account (measured on the lab data: the 2% band cut charges by ~83%;
// re-measured at band 0 on 2026-09-07, 29-31% of trades re-enter the same
// stock the next bar). The board pays that deliberately — see
// kitelab/backtest.py BAND — so the default here is 0 to match it.
upper = 1 + bandInput / 100
lower = 1 - bandInput / 100

// Entry needs ALL THREE clear of the upper line; exit needs only ONE below
// the lower line — any timeframe breaking down is reason enough to leave.
entryOk = close > emaBase * upper and close > emaMid * upper and close > emaTop * upper
exitOk  = close < emaBase * lower or  close < emaMid * lower or  close < emaTop * lower

// Only the FIRST bar where the condition turns true is a signal. Without
// this, every bar inside a long uptrend would look like a fresh entry.
freshSignal = entryOk and not entryOk[1]

// --- position sizing --------------------------------------------------------
// Fixed capital, no compounding: every trade is sized off the same base so
// results are comparable across time. Two limits, the SMALLER one wins:
//   by risk    : risk budget / rupees lost per share if the stop is hit
//   by capital : you cannot buy more than the account can pay for
var float stopPrice = na                      // 'var' = remembers its value bar to bar
riskBudget   = strategy.initial_capital * riskInput / 100
perShareRisk = close - low                    // entry (this close) minus stop (this low)
qtyByRisk    = perShareRisk > 0 ? riskBudget / perShareRisk : 0
qtyByCapital = strategy.initial_capital / close
qtyRaw       = math.min(qtyByRisk, qtyByCapital)
qty          = fracInput ? qtyRaw : math.floor(qtyRaw)   // whole shares for stocks
qtyEnough    = fracInput ? qty > 0 : qty >= 1

// --- orders -----------------------------------------------------------------
// Enter only on a supported timeframe, on a fresh signal, when flat, with a
// sizeable quantity. The fill happens at THIS bar's close.
if tfOk and freshSignal and strategy.position_size == 0 and qtyEnough
    stopPrice := low                          // the entry bar's low becomes the stop
    strategy.entry("L", strategy.long, qty = qty)

// CLASS CONVENTION IN CODE: there is NO strategy.exit(stop=...) order here.
// A resting stop order would fire the moment price TOUCHES the level
// intrabar. Instead the stop is a decision rule tested against each CLOSE —
// which is all a manual end-of-bar backtester can do.
if strategy.position_size > 0
    if exitOk
        strategy.close("L", comment = "ema break")
    else if close <= stopPrice
        strategy.close("L", comment = "stop (close)")

// --- drawing ----------------------------------------------------------------
// The three EMAs on the price chart, so every trade marker can be read
// against the rule.
plot(emaBase, "EMA20 · chart timeframe",  color = color.new(#4fc3f7, 0))
plot(emaMid,  "EMA20 · one step up",      color = color.new(#ffb74d, 0))
plot(emaTop,  "EMA20 · two steps up",     color = color.new(#ce93d8, 0))

// WHERE THE RULE ACTUALLY BITES — the band zones around the HIGHEST EMA.
// At band 0 the three lines coincide and the zones are empty; with a band set,
// signals fire that far away from the raw EMAs:
//   * ENTRY needs a close above ALL THREE upper bands, so the binding line
//     is the band above the HIGHEST of the three. The GREEN ZONE is that gap:
//     a close above the green zone's top = entry territory.
//   * EXIT fires on a close below ANY lower band; walking down, the first
//     one you can break is the band below the highest EMA. The RED ZONE is
//     that gap: a close below the red zone's bottom = exit territory.
highestEma = math.max(emaBase, math.max(emaMid, emaTop))
bandText   = str.tostring(bandInput, "#.#") + "%"
emaLine   = plot(highestEma,        "highest EMA (binding)", color = color.new(#898781, 100))
entryLine = plot(highestEma * upper, "entry line (band above)", color = color.new(#26a69a, 35))
exitLine  = plot(highestEma * lower, "exit line (band below)",  color = color.new(#ef5350, 35))
fill(entryLine, emaLine, color = color.new(#26a69a, 88), title = "band above zone")
fill(emaLine, exitLine,  color = color.new(#ef5350, 90), title = "band below zone")

// --- on-chart name tags -----------------------------------------------------
// One small label at the right edge of each line, so nobody has to guess
// which line is which. Created once ('var'), moved to the latest bar's
// values on every update.
baseName = isHourly ? "hourly" : timeframe.isdaily ? "daily" : "weekly"
midName  = isHourly ? "daily"  : timeframe.isdaily ? "weekly" : "monthly"
topName  = isHourly ? "weekly" : timeframe.isdaily ? "monthly" : "quarterly"
var label tagBase  = label.new(na, na, style = label.style_label_left, textcolor = color.white, color = color.new(#4fc3f7, 20), size = size.small)
var label tagMid   = label.new(na, na, style = label.style_label_left, textcolor = color.white, color = color.new(#ffb74d, 20), size = size.small)
var label tagTop   = label.new(na, na, style = label.style_label_left, textcolor = color.white, color = color.new(#ce93d8, 20), size = size.small)
var label tagEntry = label.new(na, na, style = label.style_label_left, textcolor = color.white, color = color.new(#26a69a, 20), size = size.small)
var label tagExit  = label.new(na, na, style = label.style_label_left, textcolor = color.white, color = color.new(#ef5350, 20), size = size.small)
if barstate.islast
    label.set_xy(tagBase, bar_index + 1, emaBase)
    label.set_text(tagBase, "EMA20 " + baseName)
    label.set_xy(tagMid, bar_index + 1, emaMid)
    label.set_text(tagMid, "EMA20 " + midName)
    label.set_xy(tagTop, bar_index + 1, emaTop)
    label.set_text(tagTop, "EMA20 " + topName)
    label.set_xy(tagEntry, bar_index + 1, highestEma * upper)
    label.set_text(tagEntry, "BUY above (+" + bandText + ")")
    label.set_xy(tagExit, bar_index + 1, highestEma * lower)
    label.set_text(tagExit, "SELL below (-" + bandText + ")")

// --- status banner ----------------------------------------------------------
// Always says which stack is running — or warns when the chart timeframe is
// unsupported, instead of silently taking no trades.
var table info = table.new(position.top_center, 1, 1)
if barstate.islast
    if not tfOk
        table.cell(info, 0, 0,
             "EMA Stack runs on 1W, 1D or 1h charts only — switch timeframe",
             bgcolor = color.new(#ef5350, 20), text_color = color.white)
    else
        stack = timeframe.isweekly ? "Q/M/W (quarterly-monthly-weekly)"
             : timeframe.isdaily  ? "M/W/D (the class strategy)"
             : "W/D/H (weekly-daily-hourly)"
        table.cell(info, 0, 0, "EMA Stack: " + stack,
             bgcolor = color.new(#26a69a, 60), text_color = color.white)
