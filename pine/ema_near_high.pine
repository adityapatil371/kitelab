// EMA · near the high  —  item 4, 2026-09-02; brought back in line 2026-09-07
//
// The class 20 EMA stack, but only buying while price is within a band of its
// own all-time high. The idea: a 20 EMA cross means more in a name already
// making highs than in one clawing back from a fall.
//
// MIRRORS kitelab/backtest.py: ema_stack_signal(stack="mwd", band=0.0,
// ath_band=0.10) for the conditions and simulate() for the walk — the `eath`
// M/W/D row on the board. What the chart shows and what the backtest counts
// are the same rule:
//
//   trend    close above the 20 EMA on DAILY, WEEKLY and MONTHLY, all three
//   cross    the FIRST bar on which that becomes true (rising edge). Only a
//            cross is a signal; the stack merely being up is not.
//   filter   the cross is taken only if the close is within 10% of the
//            running all-time high. A cross the filter declines is GONE:
//            the stack must break and cross again before the next look.
//            Price climbing back inside the band while the stack is already
//            up is NOT an entry — until 2026-09-07 this script (and the
//            Python) treated it as one, and on 250 stocks from 2018 most of
//            the family's trades came from exactly that.
//   stop     the entry candle's low, judged at CLOSES only (class convention,
//            stop_on_close=True in the Python): a wick through it does not
//            sell, a close at or below it does.
//   exit     ANY of the three closing below its EMA.
//   band     0 by default, matching kitelab.registry.SOLO_BAND since
//            2026-09-05. It used to be 2%: the input is kept so the
//            hysteresis can be looked at, not because the board trades it.
//
// The all-time high is a RUNNING maximum of the close, today included. That
// is knowable at the close and is not lookahead — unlike a high still to come.
//
// Set the chart to Daily. The weekly and monthly EMAs are the FORMING-bar
// values the Python uses: the last COMPLETED higher-timeframe EMA (the `[1]`
// + lookahead_on idiom, as in ema_stack.pine) blended with today's close by
// the EMA's own recurrence. request.security with lookahead_off would give
// the completed value one bar late instead, which is a different number on
// every day but the higher bar's last.
//
// One script only: the TradingView free plan allows a single custom script on
// a chart, so everything this rule needs is drawn here and nothing is left to
// a second study. Add built-in indicators for anything else.

//@version=6
strategy("EMA · near the high", overlay = true,
         initial_capital       = 100000,
         pyramiding            = 0,
         calc_on_every_tick    = false,
         process_orders_on_close = true,      // decisions at the close fill at that close
         commission_type       = strategy.commission.percent,
         commission_value      = 0.11)

len       = input.int(20,    "EMA length",                 minval = 2)
band      = input.float(0.0, "Band %  (dead zone; board = 0)", minval = 0, step = 0.5) / 100
athBand   = input.float(10.0,"Buy within % of the high",    minval = 0, step = 1)   / 100
useATH    = input.bool(true, "Require price near the high")
useHigher = input.bool(true, "Require weekly and monthly agreement")
riskPct   = input.float(1.0, "Risk % of capital per trade", minval = 0.1, step = 0.5)

// ── the three timeframes ───────────────────────────────────────────────────
// The daily EMA is ordinary. The weekly and monthly ones are rebuilt as the
// FORMING bar's value from the last completed higher-TF EMA:
//     ema_now = alpha * close + (1 - alpha) * ema(last COMPLETED higher bar)
// which is exactly backtest.ema_stack_signal's `forming()`.
alpha = 2.0 / (len + 1)
emaD  = ta.ema(close, len)
wDone = request.security(syminfo.tickerid, "W", ta.ema(close, len)[1], lookahead = barmerge.lookahead_on)
mDone = request.security(syminfo.tickerid, "M", ta.ema(close, len)[1], lookahead = barmerge.lookahead_on)
emaW  = alpha * close + (1 - alpha) * wDone
emaM  = alpha * close + (1 - alpha) * mDone

up   = 1 + band
down = 1 - band

// Entry wants ALL three clear of the upper line. Exit needs only ONE below the
// lower line — the asymmetry is deliberate: it is harder to get in than out.
entryOk = close > emaD * up  and (not useHigher or (close > emaW * up  and close > emaM * up))
exitOk  = close < emaD * down or  (useHigher and (close < emaW * down or close < emaM * down))

// The rising edge, on the UNFILTERED stack. This is the line that makes the
// filter a filter: the edge cannot come from nearATH switching on.
freshSignal = entryOk and not entryOk[1]

// ── the all-time high filter ───────────────────────────────────────────────
ath     = ta.max(close)                    // running max of the close, today included
nearATH = not useATH or close >= ath * (1 - athBand)

// ── sizing, as sizing.position: risk a fixed fraction, capped by capital ───
var float stopPrice = na
riskBudget   = strategy.initial_capital * riskPct / 100
perShareRisk = close - low
qty          = perShareRisk > 0 ? math.floor(math.min(riskBudget / perShareRisk, strategy.initial_capital / close)) : 0

// ── orders ─────────────────────────────────────────────────────────────────
if freshSignal and nearATH and strategy.position_size == 0 and qty >= 1
    stopPrice := low                       // the entry candle's own low
    strategy.entry("long", strategy.long, qty = qty)

// CLASS CONVENTION: no resting strategy.exit(stop=...). The stop is a rule
// tested against each CLOSE, which is all an end-of-bar backtester can do.
if strategy.position_size > 0
    if exitOk
        strategy.close("long", comment = "ema break")
    else if close <= stopPrice
        strategy.close("long", comment = "stop (close)")

// ── what you see ───────────────────────────────────────────────────────────
plot(emaD, "20 EMA daily",   color = color.new(color.blue,   0), linewidth = 2)
plot(useHigher ? emaW : na, "20 EMA weekly (forming)",
     color = color.new(color.orange, 0), linewidth = 1)
plot(useHigher ? emaM : na, "20 EMA monthly (forming)",
     color = color.new(color.purple, 0), linewidth = 1)
plot(useATH ? ath * (1 - athBand) : na, "buy-above line",
     color = color.new(color.teal, 40), style = plot.style_stepline)
plot(useATH ? ath : na, "all-time high",
     color = color.new(color.gray, 60), style = plot.style_stepline)

// Green on a cross the rule would take; red on a cross the filter declined;
// grey where the stack is up but there is no cross — the bars that used to be
// bought and are not any more.
bgcolor(freshSignal and nearATH     ? color.new(color.green, 85) :
        freshSignal and not nearATH ? color.new(color.red,   85) :
        entryOk                     ? color.new(color.gray,  94) : na)
